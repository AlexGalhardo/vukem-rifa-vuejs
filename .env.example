APP_NAME="Vukem Rifa"
APP_ENV=development
APP_URL=http://localhost:3000
# Generate with: go run ./cmd/app key:generate
APP_KEY=
# Former APP_KEY values, comma-separated: they still decrypt after a rotation.
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_LOCALE=pt-BR
PORT=3000

# PostgreSQL only (docker compose service "postgres")
DATABASE_URL=postgres://rifa:rifa@localhost:5432/rifa?sslmode=disable
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
# Rate limits counted in the database cache: shared by every instance (memory = per process)
RATE_LIMIT_STORE=cache
# serve runs the database queue worker (vukem default; false when queue:work runs as a separate service)
QUEUE_IN_SERVE=true
# serve runs the scheduler (vukem default; false when schedule:work runs as a separate service)
SCHEDULE_IN_SERVE=true
# Behind Railway: only after verifying the edge range (see README), e.g. TRUSTED_PROXIES=<range> CLIENT_IP_HEADER=X-Real-IP TRUST_FORWARDED_PROTO=true
TRUSTED_PROXIES=

# Mail: SMTP. Local offline = Mailpit (localhost:1025, UI :8025).
# Dev/staging/e2e = Mailtrap Email Sandbox (sandbox.smtp.mailtrap.io:2525).
MAIL_MAILER=smtp
MAIL_FROM="Vukem Rifa <no-reply@rifa.vukem.dev>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# Mailpit speaks plain SMTP; never set this outside local development.
SMTP_INSECURE=true

# Mailtrap Sandbox API (tests assert delivered emails); optional locally.
MAILTRAP_API_TOKEN=
MAILTRAP_ACCOUNT_ID=
MAILTRAP_SANDBOX_ID=

# AbacatePay (PIX) — dev-mode key from the AbacatePay dashboard (Phase 4)
# Without a key the app boots and the buyer's "confirm" answers 503.
ABACATEPAY_API_KEY=
# The webhook URL is APP_URL/webhooks/abacatepay?webhookSecret=<this secret>.
ABACATEPAY_WEBHOOK_SECRET=
# Optional: defaults to https://api.abacatepay.com/v2.
ABACATEPAY_BASE_URL=
# Optional override of the published key AbacatePay signs X-Webhook-Signature with.
ABACATEPAY_WEBHOOK_PUBLIC_KEY=
# true = in-memory fake gateway + /dev helpers (development/e2e only; refused in production).
ABACATEPAY_FAKE=false

# Google OAuth (callback: APP_URL/auth/google/callback)
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
